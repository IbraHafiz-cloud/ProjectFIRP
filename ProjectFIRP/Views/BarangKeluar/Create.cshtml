@model ProjectFIRP.Models.BarangKeluar

@{
    ViewData["Title"] = "Input Barang Keluar";
}

<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0"><i class="fas fa-minus-circle me-2"></i>Input Barang Keluar</h5>
        </div>
        <div class="card-body">
            @if (TempData["success"] != null)
            {
                <div class="alert alert-success">@TempData["success"]</div>
            }

            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label asp-for="NamaBarang" class="form-label"></label>
                    <input asp-for="NamaBarang" class="form-control" placeholder="Contoh: Vitamin C 1000mg" />
                    <span asp-validation-for="NamaBarang" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Jumlah" class="form-label"></label>
                    <input asp-for="Jumlah" type="number" class="form-control" placeholder="Jumlah keluar" />
                    <span asp-validation-for="Jumlah" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TanggalKeluar" class="form-label"></label>
                    <input asp-for="TanggalKeluar" type="date" class="form-control" />
                    <span asp-validation-for="TanggalKeluar" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Keterangan" class="form-label"></label>
                    <textarea asp-for="Keterangan" class="form-control" rows="3" placeholder="Keterangan tambahan (opsional)"></textarea>
                    <span asp-validation-for="Keterangan" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-danger"><i class="fas fa-save me-1"></i> Simpan</button>
                <a asp-action="Index" class="btn btn-secondary">Kembali</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

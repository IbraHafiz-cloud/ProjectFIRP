@model List<ProjectFIRP.Models.BarangKeluar>

@{
    ViewData["Title"] = "Barang Keluar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <!-- Header dan Tombol Tambah -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Barang Keluar</h5>
        <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#createModal">
            <i class="fas fa-plus-circle me-1"></i> Tambah Barang
        </button>
    </div>

    <!-- Notifikasi sukses -->
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success">@TempData["success"]</div>
    }

    <!-- Modal Create -->
    <div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="Index" method="post">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title" id="createModalLabel">Tambah Barang Keluar</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Nama Barang</label>
                            <input name="NamaBarang" class="form-control" placeholder="Contoh: Vitamin C 1000mg" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Jumlah</label>
                            <input name="Jumlah" type="number" class="form-control" min="1" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Tanggal Keluar</label>
                            <input name="TanggalKeluar" type="date" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Keterangan</label>
                            <textarea name="Keterangan" class="form-control" rows="2" placeholder="Opsional: alasan keluar, kondisi, dsb."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-success">Simpan</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- TABEL DATA -->
    <div class="card shadow rounded-3 border-0">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-table me-2"></i>Data Barang Keluar</h5>
        </div>
        <div class="card-body table-responsive">
            @if (!Model.Any())
            {
                <p class="text-muted">Belum ada data barang keluar.</p>
            }
            else
            {
                <table class="table table-bordered table-striped align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Nama Barang</th>
                            <th>Jumlah</th>
                            <th>Tanggal Keluar</th>
                            <th>Keterangan</th>
                            <th style="width: 100px;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var item = Model[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@item.NamaBarang</td>
                                <td>@item.Jumlah</td>
                                <td>@item.TanggalKeluar.ToString("dd/MM/yyyy")</td>
                                <td>@item.Keterangan</td>
                                <td>
                                    <!-- Tombol Edit -->
                                    <button class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#editModal-@item.Id">
                                        <i class="fas fa-edit"></i>
                                    </button>

                                    <!-- Tombol Hapus -->
                                    <form asp-action="Delete" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button class="btn btn-sm btn-danger" onclick="return confirm('Yakin ingin menghapus?')">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>

                            <!-- Modal Edit -->
                            <div class="modal fade" id="editModal-@item.Id" tabindex="-1" aria-labelledby="editModalLabel-@item.Id" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <form asp-action="Edit" method="post">
                                            <div class="modal-header bg-warning text-dark">
                                                <h5 class="modal-title">Edit Barang Keluar</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <input type="hidden" name="Id" value="@item.Id" />
                                                <div class="mb-3">
                                                    <label class="form-label">Nama Barang</label>
                                                    <input name="NamaBarang" class="form-control" value="@item.NamaBarang" required />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Jumlah</label>
                                                    <input name="Jumlah" type="number" class="form-control" value="@item.Jumlah" required />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Tanggal Keluar</label>
                                                    <input name="TanggalKeluar" type="date" class="form-control" value="@item.TanggalKeluar.ToString("yyyy-MM-dd")" required />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Keterangan</label>
                                                    <textarea name="Keterangan" class="form-control">@item.Keterangan</textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="submit" class="btn btn-success">Simpan</button>
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

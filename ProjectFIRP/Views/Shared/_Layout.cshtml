<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProjectFIRP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            overflow-x: hidden;
        }

        .sidebar {
            min-height: 100vh;
            background-color: #343a40;
            color: white;
        }

            .sidebar a {
                color: white;
                display: block;
                padding: 10px 20px;
                text-decoration: none;
            }

                .sidebar a:hover {
                    background-color: #495057;
                }

        .content {
            margin-left: 220px;
            padding: 20px;
        }

        .sidebar .logo {
            padding: 15px 20px;
            border-bottom: 1px solid #495057;
        }

        .navbar .badge {
            font-size: 0.65rem;
            padding: 4px 6px;
        }

        .topbar {
            margin-left: 220px;
            z-index: 1030;
        }
    </style>
</head>
<body>

    <!-- Top Navbar -->
    <nav class="navbar navbar-expand navbar-dark position-sticky top-0 w-100" style="background-color: #f39c12; z-index: 1030;">

        <div class="container-fluid">
            <button class="btn btn-warning me-3" id="sidebarToggle">
                <i class="fas fa-bars"></i>
            </button>

            <span class="navbar-brand mb-0 h5 text-white">Dashboard</span>

            <ul class="navbar-nav ms-auto align-items-center">
                <li class="nav-item me-3">
                    <a class="nav-link text-white position-relative" href="#">
                        <i class="fas fa-envelope"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-success">4</span>
                    </a>
                </li>
                <li class="nav-item me-3">
                    <a class="nav-link text-white position-relative" href="#">
                        <i class="fas fa-bell"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">10</span>
                    </a>
                </li>
            </ul>
        </div>
    </nav>

    <div class="d-flex">
        <!-- Sidebar -->
        <div class="sidebar position-fixed d-flex flex-column" style="width: 220px;">
            

            <!-- USER INFO -->
            <div class="text-center p-3 border-bottom">
                <img src="https://via.placeholder.com/80" class="rounded-circle mb-2" alt="User Image" />
                <h6 class="mb-0">
                    @if (User.Identity.IsAuthenticated)
                    {
                        @User.Identity.Name
                    }
                    else
                    {
                        @:Guest
                    }
                </h6>
                <span class="text-success small"><i class="fas fa-circle"></i> Online</span>
            </div>
        

            <!-- MENU -->
            <a href="/Home/Index"><i class="fas fa-home me-2"></i> Home</a>
            <a href="/Home/Privacy"><i class="fas fa-shield-alt me-2"></i> Privacy</a>
            <a href="/Home/Dashboard"><i class="fas fa-chart-line me-2"></i> Dashboard</a>
            <a href="/BarangMasuk/Create"><i class="fas fa-chart-line me-2"></i> BarangMasuk</a>
            <a href="/BarangKeluar/Create"><i class="fas fa-chart-line me-2"></i> BarangKeluar</a>
            <a href="/StokObat/Index"><i class="fas fa-pills me-2"></i> Stok Obat</a>
            <a href="/Transaksi/Index"><i class="fas fa-exchange-alt me-2"></i> Transaksi</a>
            <a href="/Laporan/Inventaris"><i class="fas fa-file-alt me-2"></i> Laporan Inventaris</a>



            <hr class="bg-light">
            @if (User.Identity.IsAuthenticated)
            {
                <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="px-3">
                    <button type="submit" class="btn btn-link text-white ps-0"><i class="fas fa-sign-out-alt me-2"></i> Logout</button>
                </form>
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Login"><i class="fas fa-sign-in-alt me-2"></i> Login</a>
                <a asp-area="Identity" asp-page="/Account/Register"><i class="fas fa-user-plus me-2"></i> Register</a>
            }
        </div>

        <!-- Main Content -->
        <div class="content w-100">
            @RenderBody()
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js"></script>
    <script>
        document.getElementById("sidebarToggle").addEventListener("click", function () {
            document.querySelector(".sidebar").classList.toggle("d-none");
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model ProjectFIRP.Models.BarangMasuk

@{
    ViewData["Title"] = "Input Barang Masuk";
}

<div class="container mt-4">
    <div class="card shadow rounded-3 border-0">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Input Barang Masuk</h5>
        </div>
        <div class="card-body">
            @if (TempData["success"] != null)
            {
                <div class="alert alert-success">@TempData["success"]</div>
            }

            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label asp-for="NamaBarang" class="form-label"></label>
                    <input asp-for="NamaBarang" class="form-control" placeholder="Contoh: Paracetamol 500mg" />
                    <span asp-validation-for="NamaBarang" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Jumlah" class="form-label"></label>
                    <input asp-for="Jumlah" type="number" class="form-control" min="1" placeholder="Jumlah masuk" />
                    <span asp-validation-for="Jumlah" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TanggalMasuk" class="form-label"></label>
                    <input asp-for="TanggalMasuk" class="form-control" type="date" />
                    <span asp-validation-for="TanggalMasuk" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Keterangan" class="form-label"></label>
                    <textarea asp-for="Keterangan" class="form-control" rows="3" placeholder="Opsional: asal barang, kondisi, dll."></textarea>
                    <span asp-validation-for="Keterangan" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success"><i class="fas fa-save me-1"></i> Simpan</button>
                <a asp-action="Index" class="btn btn-secondary">Kembali</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

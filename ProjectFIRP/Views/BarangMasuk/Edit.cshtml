@model ProjectFIRP.Models.BarangMasuk

@{
    ViewData["Title"] = "Edit Barang Masuk";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow rounded-3 border-0">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0"><i class="fas fa-edit me-2"></i>Edit Barang Masuk</h5>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label asp-for="NamaBarang" class="form-label"></label>
                    <input asp-for="NamaBarang" class="form-control" />
                    <span asp-validation-for="NamaBarang" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Jumlah" class="form-label"></label>
                    <input asp-for="Jumlah" type="number" class="form-control" />
                    <span asp-validation-for="Jumlah" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TanggalMasuk" class="form-label"></label>
                    <input asp-for="TanggalMasuk" type="date" class="form-control" />
                    <span asp-validation-for="TanggalMasuk" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Keterangan" class="form-label"></label>
                    <textarea asp-for="Keterangan" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Keterangan" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-warning">Simpan Perubahan</button>
                <a asp-action="Index" class="btn btn-secondary">Kembali</a>
            </form>
        </div>
    </div>
</div>

@model IEnumerable<ProjectFIRP.Models.LaporanInventarisViewModel>

@{
    ViewData["Title"] = "Laporan Inventaris";
}

<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-file-alt me-2"></i>Laporan Inventaris</h5>
        </div>
        <div class="card-body table-responsive">
            <table class="table table-striped table-bordered text-center align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>No</th>
                        <th>Nama Barang</th>
                        <th>Total Masuk</th>
                        <th>Total Keluar</th>
                        <th>Stok Akhir</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-muted">Data belum tersedia</td></tr>
                    }
                    else
                    {
                        int no = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@no</td>
                                <td>@item.NamaBarang</td>
                                <td>@item.TotalMasuk</td>
                                <td>@item.TotalKeluar</td>
                                <td><strong>@item.StokAkhir</strong></td>
                            </tr>
                            no++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@model IEnumerable<ProjectFIRP.Models.StokObat>

@{
    ViewData["Title"] = "Stok Obat";
}

<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="fas fa-pills me-2"></i>Daftar Stok Obat</h5>
        </div>
        <div class="card-body table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-dark text-center">
                    <tr>
                        <th>No</th>
                        <th>Nama Obat</th>
                        <th>Jumlah</th>
                        <th>Tanggal Expired</th>
                        <th>Keterangan</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">Tidak ada data stok obat</td>
                        </tr>
                    }
                    else
                    {
                        int no = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">@no</td>
                                <td>@item.NamaObat</td>
                                <td class="text-center">@item.Jumlah</td>
                                <td class="text-center">@item.TanggalExpired?.ToString("dd MMM yyyy")</td>
                                <td>@item.Keterangan</td>
                            </tr>
                            no++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@model IEnumerable<ProjectFIRP.Models.StokObatViewModel>

@{
    ViewData["Title"] = "Stok Obat";
}

<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0">
                <i class="fas fa-pills me-2"></i>Stok Obat Terkini
            </h5>
        </div>
        <div class="card-body table-responsive">
            <table class="table table-bordered table-striped align-middle">
                <thead class="table-dark text-center">
                    <tr>
                        <th>No</th>
                        <th>Nama Obat</th>
                        <th>Masuk</th>
                        <th>Keluar</th>
                        <th>Stok Sisa</th>
                        <th>Expired</th>
                        <th>Keterangan</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted">
                                Tidak ada data stok
                            </td>
                        </tr>
                    }
                    else
                    {
                        var no = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">@no</td>
                                <td>@item.NamaObat</td>
                                <td class="text-center">@item.TotalMasuk</td>
                                <td class="text-center">@item.TotalKeluar</td>
                                <td class="text-center fw-bold @(item.StokSisa <= 0 ? "text-danger" : "")">
                                    @item.StokSisa
                                </td>
                                <td class="text-center">
                                    @(item.ExpiredTerbaru.HasValue
                                        ? item.ExpiredTerbaru.Value.ToString("dd MMM yyyy")
                                        : "-")
                                </td>
                                <td>@item.Keterangan</td>
                            </tr>
                            no++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

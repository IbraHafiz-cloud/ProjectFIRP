@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
}
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/register.css" />

<div class="register-wrapper">
    <!-- KIRI: Ilustrasi -->
    <div class="register-left">
        <img src="~/images/Register2.jpeg" alt="Healthcare Illustration" />
    </div>

    <!-- KANAN: Form -->
    <div class="register-right">
        <div class="form-container">
            <h4>Selamat Datang</h4>
            <p>Sistem Informasi Inventory Klinik Aesthenia</p>
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group-custom">
                    <input asp-for="Input.Email" class="input-custom" autocomplete="username" required />
                    <label>Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-group-custom">
                    <input asp-for="Input.Password" class="input-custom" autocomplete="new-password" required />
                    <label>Password</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-group-custom">
                    <input asp-for="Input.ConfirmPassword" class="input-custom" autocomplete="new-password" required />
                    <label>Confirm Password</label>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>


                <div class="actions">
                    <button type="submit" class="btn register-btn">Register</button>
                </div>
            </form>
            <div class="already-account">
                <span>Sudah punya akun?</span>
                <a asp-page="./Login">Masuk di sini</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
